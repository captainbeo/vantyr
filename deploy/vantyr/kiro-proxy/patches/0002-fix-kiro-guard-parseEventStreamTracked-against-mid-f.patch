diff --git a/proxy/idle_timeout_reader.go b/proxy/idle_timeout_reader.go
new file mode 100644
index 0000000..cf9d9bc
--- /dev/null
+++ b/proxy/idle_timeout_reader.go
@@ -0,0 +1,67 @@
+package proxy
+
+import (
+	"context"
+	"io"
+	"sync"
+	"time"
+)
+
+// idleTimeoutReader wraps an io.Reader and enforces an idle timeout: if no
+// bytes are read for the specified duration, the context is canceled and
+// subsequent reads return ctx.Err(). This guards against mid-frame stalls in
+// streaming responses where io.ReadFull blocks indefinitely without a deadline.
+type idleTimeoutReader struct {
+	r       io.Reader
+	ctx     context.Context
+	cancel  context.CancelFunc
+	timeout time.Duration
+	mu      sync.Mutex
+	timer   *time.Timer
+}
+
+// newIdleTimeoutReader wraps r and cancels ctx if r remains idle for timeout.
+// Once the context is canceled, Read returns ctx.Err().
+func newIdleTimeoutReader(r io.Reader, ctx context.Context, timeout time.Duration) *idleTimeoutReader {
+	ctx, cancel := context.WithCancel(ctx)
+	itr := &idleTimeoutReader{
+		r:       r,
+		ctx:     ctx,
+		cancel:  cancel,
+		timeout: timeout,
+	}
+	itr.timer = time.AfterFunc(timeout, func() {
+		itr.mu.Lock()
+		defer itr.mu.Unlock()
+		cancel()
+	})
+	return itr
+}
+
+func (itr *idleTimeoutReader) Read(p []byte) (n int, err error) {
+	// Check context before blocking on Read.
+	if err := itr.ctx.Err(); err != nil {
+		return 0, err
+	}
+
+	n, err = itr.r.Read(p)
+	if n > 0 || err != nil {
+		itr.mu.Lock()
+		if itr.timer != nil {
+			itr.timer.Reset(itr.timeout)
+		}
+		itr.mu.Unlock()
+	}
+	return n, err
+}
+
+// Close stops the idle timer. The underlying reader is not closed.
+func (itr *idleTimeoutReader) Close() error {
+	itr.mu.Lock()
+	defer itr.mu.Unlock()
+	if itr.timer != nil {
+		itr.timer.Stop()
+		itr.timer = nil
+	}
+	return nil
+}
diff --git a/proxy/idle_timeout_reader_test.go b/proxy/idle_timeout_reader_test.go
new file mode 100644
index 0000000..8487bfe
--- /dev/null
+++ b/proxy/idle_timeout_reader_test.go
@@ -0,0 +1,113 @@
+package proxy
+
+import (
+	"context"
+	"io"
+	"strings"
+	"testing"
+	"time"
+)
+
+// slowReader simulates a reader that stalls for a specified duration before
+// returning data.
+type slowReader struct {
+	data  string
+	delay time.Duration
+	read  bool
+}
+
+func (s *slowReader) Read(p []byte) (n int, err error) {
+	if s.read {
+		return 0, io.EOF
+	}
+	time.Sleep(s.delay)
+	s.read = true
+	n = copy(p, s.data)
+	return n, nil
+}
+
+func TestIdleTimeoutReaderCancelsOnIdle(t *testing.T) {
+	ctx := context.Background()
+	slow := &slowReader{data: "hello", delay: 10 * time.Second}
+	itr := newIdleTimeoutReader(slow, ctx, 50*time.Millisecond)
+	defer itr.Close()
+
+	// The first Read should block for 10s, but the idle timer fires after 50ms
+	// and cancels the context. The reader checks ctx.Err() before blocking,
+	// so we should get context.Canceled within ~50-100ms.
+	start := time.Now()
+	buf := make([]byte, 100)
+	n, err := itr.Read(buf)
+	elapsed := time.Since(start)
+
+	if err != context.Canceled {
+		t.Fatalf("expected context.Canceled after idle timeout, got %v (read %d bytes in %s)", err, n, elapsed)
+	}
+	if elapsed > 200*time.Millisecond {
+		t.Fatalf("idle timeout took too long: %s (expected ~50ms)", elapsed)
+	}
+}
+
+func TestIdleTimeoutReaderResetsOnActivity(t *testing.T) {
+	ctx := context.Background()
+	r := strings.NewReader("abcdefghij")
+	itr := newIdleTimeoutReader(r, ctx, 100*time.Millisecond)
+	defer itr.Close()
+
+	// Read 5 bytes, wait 80ms (under timeout), read 5 more. The timer should
+	// reset after the first read, so the second read should succeed.
+	buf := make([]byte, 5)
+	n, err := itr.Read(buf)
+	if err != nil || n != 5 || string(buf[:n]) != "abcde" {
+		t.Fatalf("first read failed: n=%d err=%v data=%q", n, err, buf[:n])
+	}
+
+	time.Sleep(80 * time.Millisecond)
+
+	n, err = itr.Read(buf)
+	if err != nil || n != 5 || string(buf[:n]) != "fghij" {
+		t.Fatalf("second read failed after timer reset: n=%d err=%v data=%q", n, err, buf[:n])
+	}
+}
+
+func TestIdleTimeoutReaderPassesEOF(t *testing.T) {
+	ctx := context.Background()
+	r := strings.NewReader("hi")
+	itr := newIdleTimeoutReader(r, ctx, 1*time.Second)
+	defer itr.Close()
+
+	buf := make([]byte, 10)
+	n, err := itr.Read(buf)
+	if err != nil || n != 2 || string(buf[:n]) != "hi" {
+		t.Fatalf("first read failed: n=%d err=%v", n, err)
+	}
+
+	n, err = itr.Read(buf)
+	if err != io.EOF {
+		t.Fatalf("expected EOF on exhausted reader, got n=%d err=%v", n, err)
+	}
+}
+
+func TestIdleTimeoutReaderCloseStopsTimer(t *testing.T) {
+	ctx := context.Background()
+	slow := &slowReader{data: "data", delay: 10 * time.Second}
+	itr := newIdleTimeoutReader(slow, ctx, 50*time.Millisecond)
+
+	// Close immediately. The timer should stop, and the context should not be
+	// canceled (because Close stops the timer before it fires).
+	if err := itr.Close(); err != nil {
+		t.Fatalf("Close failed: %v", err)
+	}
+
+	time.Sleep(100 * time.Millisecond)
+
+	// The timer was stopped, but the Read still checks ctx.Err(). If ctx is
+	// still active, the slow reader will block for 10s. We'll just check that
+	// the context hasn't been canceled yet.
+	select {
+	case <-itr.ctx.Done():
+		t.Fatalf("context was canceled after Close (timer should have been stopped)")
+	default:
+		// ok
+	}
+}
