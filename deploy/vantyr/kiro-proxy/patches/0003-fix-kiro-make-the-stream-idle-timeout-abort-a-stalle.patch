diff --git a/proxy/kiro.go b/proxy/kiro.go
index 7463a20..524afcc 100644
--- a/proxy/kiro.go
+++ b/proxy/kiro.go
@@ -458,14 +458,10 @@ endpointLoop:
 				continue endpointLoop
 			}
 
-			//! Guard against mid-frame stalls: io.ReadFull blocks indefinitely if
-			//! the upstream stops sending data mid-frame. The idle timeout reader
-			//! cancels ctx after 5 minutes of read inactivity, causing the next
-			//! ReadFull to unblock and check ctx.Err().
-			idleBody := newIdleTimeoutReader(resp.Body, ctx, 5*time.Minute)
-			defer idleBody.Close()
-
+			//! No total client timeout (long answers run past 5 minutes), so bound idle time instead.
+			idleBody := newIdleTimeoutReader(resp.Body, streamIdleTimeout)
 			emitted, err := parseEventStreamTracked(idleBody, callback)
+			idleBody.Close()
 			resp.Body.Close()
 			if err == nil {
 				return nil
@@ -513,6 +509,10 @@ func isRetryableStreamError(err error) bool {
 	if errors.Is(err, context.Canceled) || errors.Is(err, context.DeadlineExceeded) {
 		return false
 	}
+	//! A stall already cost streamIdleTimeout; retrying would cost it again.
+	if errors.Is(err, errStreamIdleTimeout) {
+		return false
+	}
 	var netErr net.Error
 	return !errors.As(err, &netErr) || !netErr.Timeout()
 }
