From e406cba24f57fee2ada76a65ccb1a8303e75e0e1 Mon Sep 17 00:00:00 2001
From: captainbeo <captainbeo@outlook.com>
Date: Tue, 27 Oct 2026 14:12:24 +0100
Subject: [PATCH 3/3] fix(kiro): make the stream idle timeout abort a stalled
 read

fcddf06's idleTimeoutReader cancelled a context derived from the request
context. The HTTP transport only watches the context the request was made
with, so a stalled Read never unblocked (its own test blocked the full 10s).
Close the body instead, which aborts the HTTP/1.1 connection or the HTTP/2
stream, and report the read as errStreamIdleTimeout. An idle timeout is not
retried: the stall already cost five minutes. The reader is now closed per
attempt instead of deferred inside the retry loop.

Tests: unblocks a stalled pipe and a real HTTP/1.1 and HTTP/2 body, resets on
activity, passes EOF, Close stops the timer.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 proxy/idle_timeout_reader.go      |  81 +++++++-------
 proxy/idle_timeout_reader_test.go | 171 ++++++++++++++++--------------
 proxy/kiro.go                     |  14 +--
 3 files changed, 136 insertions(+), 130 deletions(-)

diff --git a/proxy/idle_timeout_reader.go b/proxy/idle_timeout_reader.go
index cf9d9bc..aa747ed 100644
--- a/proxy/idle_timeout_reader.go
+++ b/proxy/idle_timeout_reader.go
@@ -1,67 +1,60 @@
 package proxy
 
 import (
-	"context"
+	"errors"
 	"io"
-	"sync"
+	"sync/atomic"
 	"time"
 )
 
-// idleTimeoutReader wraps an io.Reader and enforces an idle timeout: if no
-// bytes are read for the specified duration, the context is canceled and
-// subsequent reads return ctx.Err(). This guards against mid-frame stalls in
-// streaming responses where io.ReadFull blocks indefinitely without a deadline.
+// streamIdleTimeout bounds how long a Kiro stream may go without sending a
+// byte. The gateway's own streaming timeout normally fires first; this is the
+// backstop now that the 5-minute total http.Client.Timeout is gone.
+const streamIdleTimeout = 5 * time.Minute
+
+// errStreamIdleTimeout reports a stream that sent nothing for the idle timeout.
+var errStreamIdleTimeout = errors.New("upstream stream idle timeout")
+
+// idleTimeoutReader guards a streaming body against stalls (Vantyr fork,
+// 2026-10-27). parseEventStreamTracked reads with io.ReadFull, which blocks
+// until the body yields data, so a stream that goes silent would hang forever
+// without the old total timeout. When no bytes arrive for timeout, the reader
+// closes the body: that aborts the connection (HTTP/1.1) or the stream
+// (HTTP/2) and unblocks the pending Read, whose error is then reported as
+// errStreamIdleTimeout. Cancelling a context derived from the request context
+// would not work: the transport only watches the context the request was
+// made with.
 type idleTimeoutReader struct {
-	r       io.Reader
-	ctx     context.Context
-	cancel  context.CancelFunc
-	timeout time.Duration
-	mu      sync.Mutex
-	timer   *time.Timer
+	body     io.ReadCloser
+	timeout  time.Duration
+	timer    *time.Timer
+	timedOut atomic.Bool
+	stopped  atomic.Bool
 }
 
-// newIdleTimeoutReader wraps r and cancels ctx if r remains idle for timeout.
-// Once the context is canceled, Read returns ctx.Err().
-func newIdleTimeoutReader(r io.Reader, ctx context.Context, timeout time.Duration) *idleTimeoutReader {
-	ctx, cancel := context.WithCancel(ctx)
-	itr := &idleTimeoutReader{
-		r:       r,
-		ctx:     ctx,
-		cancel:  cancel,
-		timeout: timeout,
-	}
+func newIdleTimeoutReader(body io.ReadCloser, timeout time.Duration) *idleTimeoutReader {
+	itr := &idleTimeoutReader{body: body, timeout: timeout}
 	itr.timer = time.AfterFunc(timeout, func() {
-		itr.mu.Lock()
-		defer itr.mu.Unlock()
-		cancel()
+		itr.timedOut.Store(true)
+		_ = body.Close()
 	})
 	return itr
 }
 
-func (itr *idleTimeoutReader) Read(p []byte) (n int, err error) {
-	// Check context before blocking on Read.
-	if err := itr.ctx.Err(); err != nil {
-		return 0, err
+func (itr *idleTimeoutReader) Read(p []byte) (int, error) {
+	n, err := itr.body.Read(p)
+	if n > 0 && !itr.stopped.Load() {
+		itr.timer.Reset(itr.timeout)
 	}
-
-	n, err = itr.r.Read(p)
-	if n > 0 || err != nil {
-		itr.mu.Lock()
-		if itr.timer != nil {
-			itr.timer.Reset(itr.timeout)
-		}
-		itr.mu.Unlock()
+	if err != nil && itr.timedOut.Load() {
+		return n, errStreamIdleTimeout
 	}
 	return n, err
 }
 
-// Close stops the idle timer. The underlying reader is not closed.
+// Close stops the idle timer. The body itself is closed by its owner.
 func (itr *idleTimeoutReader) Close() error {
-	itr.mu.Lock()
-	defer itr.mu.Unlock()
-	if itr.timer != nil {
-		itr.timer.Stop()
-		itr.timer = nil
-	}
+	itr.stopped.Store(true)
+	itr.timer.Stop()
 	return nil
 }
