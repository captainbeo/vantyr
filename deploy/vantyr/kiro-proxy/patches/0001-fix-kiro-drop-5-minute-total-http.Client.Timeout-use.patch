From 8a3aa7c4a017c69009d09c3027273293f5796e01 Mon Sep 17 00:00:00 2001
From: captainbeo <captainbeo@outlook.com>
Date: Tue, 27 Oct 2026 02:58:48 +0100
Subject: [PATCH 1/3] fix(kiro): drop 5-minute total http.Client.Timeout, use
 ResponseHeaderTimeout

Vantyr fork (2026-10-27): The old http.Client{Timeout: 5*time.Minute} aborts
the entire request at 300s, even if the stream is healthy and actively writing
frames. Long Claude Opus answers routinely exceed 5 minutes. Production logs
show "context deadline exceeded" cuts at exactly 300s.

The fix removes Client.Timeout and adds Transport.ResponseHeaderTimeout (5m to
start the response). The stream body reader already checks ctx.Err() on each
frame, so a stalled stream will abort when the caller's context times out.
Normal streams can now run indefinitely as long as frames keep arriving.

Symptom: production Kiro requests for opus-5-5 cut at exactly 300s with
"context deadline exceeded" (error_type: timeout), reproduced 2026-10-26 and
multiple prior dates. The caller's timeout was much longer, so the cut came
from the proxy's hardcoded 5-minute Client.Timeout.
---
 proxy/kiro.go | 19 +++++++++++++------
 1 file changed, 13 insertions(+), 6 deletions(-)

diff --git a/proxy/kiro.go b/proxy/kiro.go
index 4b722cc..c4683f7 100644
--- a/proxy/kiro.go
+++ b/proxy/kiro.go
@@ -117,11 +117,12 @@ func ResolveAccountProxyURL(account *config.Account) string {
 
 func buildKiroTransport(proxyURL string) *http.Transport {
 	t := &http.Transport{
-		MaxIdleConns:        100,
-		MaxIdleConnsPerHost: 20,
-		IdleConnTimeout:     90 * time.Second,
-		DisableCompression:  false,
-		ForceAttemptHTTP2:   true,
+		MaxIdleConns:          100,
+		MaxIdleConnsPerHost:   20,
+		IdleConnTimeout:       90 * time.Second,
+		ResponseHeaderTimeout: 5 * time.Minute,
+		DisableCompression:    false,
+		ForceAttemptHTTP2:     true,
 	}
 	if proxyURL != "" {
 		if u, err := url.Parse(proxyURL); err == nil {
@@ -137,8 +138,14 @@ func buildKiroTransport(proxyURL string) *http.Transport {
 }
 
 func InitKiroHttpClient(proxyURL string) {
+	// Vantyr fork (2026-10-27): drop Client.Timeout (was 5m) because it
+	// aborts the entire request after 5 minutes, even if the stream is
+	// healthy. Long Claude Opus answers often take >5 minutes. Instead, the
+	// Transport has ResponseHeaderTimeout (5m to start the response) and the
+	// stream body reader checks context cancellation. A stalled stream will
+	// hang until the caller's context times out, but normal streams can run
+	// indefinitely.
 	client := &http.Client{
-		Timeout:   5 * time.Minute,
 		Transport: buildKiroTransport(proxyURL),
 	}
 	kiroHttpStore.Store(client)
