vantyr.xyz {
    # Corresponding Source (AGPL) archive + notices served from ./static/.
    # The SPA's own /static/js/* assets are NOT intercepted: these handles
    # match only /static/source/* and /static/brand/*.
    handle /static/source/* {
        root * /srv/vantyr-static
        # /static/source/x -> /srv/vantyr-static/source/x
        uri strip_prefix /static
        file_server
    }
    handle /static/brand/* {
        root * /srv/vantyr-static
        # /static/brand/logo.png -> /srv/vantyr-static/brand/logo.png
        uri strip_prefix /static
        file_server
    }
    reverse_proxy gateway:3000 {
        transport http {
            read_timeout 600s
        }
    }
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options nosniff
        -Server
    }
}

# GM Pay (epusdt) crypto top-up gateway. Own site block: the cashier is a
# full hosted page with absolute URLs built from app_uri=https://pay.vantyr.xyz.
pay.vantyr.xyz {
    reverse_proxy gmpay:8000
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options nosniff
        -Server
    }
}
