# Global options.
# read_body_idle -1s: Caddy v2.11.6 made read_body_idle default to 60s, and
# its deadline is never cleared after the request body is read. On HTTP/1.1
# that cancels every long POST stream (Claude Code /v1/messages) exactly 60s
# after the body was read, mid-answer: caddy#8103 / #8106. Reproduced on this
# host 2026-10-26 (2.11.6 cut at 60.0s; 2.8 and 2.11.6+this option completed).
# Disabling it removes no protection we relied on: the per-route
# reverse_proxy read_timeout values below still bound upstream reads.
{
	servers {
		timeouts {
			read_body_idle -1s
		}
	}
}

# www alias: Google Search Console property was created as
# https://www.vantyr.xyz — serve the verification file on www too, and
# permanently redirect everything else to the canonical apex.
# (Caddy only fetches the www certificate once the CNAME resolves.)
www.vantyr.xyz {
    handle /google*.html {
        root * /srv/vantyr-static/verification
        file_server
    }
    redir https://vantyr.xyz{uri} 308
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options nosniff
        -Server
    }
}

vantyr.xyz {
    # Corresponding Source (AGPL) archive + notices served from ./static/.
    # The SPA's own /static/js/* assets are NOT intercepted: these handles
    # match only /static/source/* and /static/brand/*.
    handle /static/source/* {
        root * /srv/vantyr-static
        # /static/source/x -> /srv/vantyr-static/source/x
        uri strip_prefix /static
        file_server
    }
    handle /static/brand/* {
        root * /srv/vantyr-static
        # /static/brand/logo.png -> /srv/vantyr-static/brand/logo.png
        uri strip_prefix /static
        file_server
    }
    # Sign-up explainer videos (one per language), rendered by the Remotion
    # project. Same pattern as brand: /static/video/<file>.mp4 ->
    # ./static/video/<file>.mp4.
    handle /static/video/* {
        root * /srv/vantyr-static
        uri strip_prefix /static
        file_server
    }
    # Google Search Console HTML-file verification (root-level
    # google<token>.html, placed in static/verification/).
    handle /google*.html {
        root * /srv/vantyr-static/verification
        file_server
    }

    # Prerendered per-locale landing shells (SEO Phase B): serve the static
    # translated pages at /<locale>/ from static/locale/<locale>/index.html.
    # Everything else under the locale prefix (assets, sub-paths) falls through
    # to the SPA below. The root-level matcher keeps the apex and unknown
    # paths on the SPA untouched.
    @locales path /fr/ /ru/ /zh/ /zh-TW/ /vi/ /ja/ /de/ /nl/ /tr/ /es/ /ar/
    handle @locales {
        rewrite * /locale{uri}index.html
        root * /srv/vantyr-static
        file_server
    }
    # /fr (no trailing slash) -> /fr/ so the locale shell matches.
    @localesBare path /fr /ru /zh /zh-TW /vi /ja /de /nl /tr /es /ar
    redir @localesBare {uri}/ 308

    # Setup & pricing guide (static HTML in Control Room styling).
    # /docs -> /docs/ (canonical trailing slash); /docs/* serves
    # static/docs/ directly so relative font paths resolve.
    # NOTE: redir needs the absolute target URL here — the two-argument
    # form `redir /docs/ 308` parses as "redirect to URL '308' with code
    # 302", which broke the no-slash path (SPA fallback served instead).
    handle /docs {
        redir https://vantyr.xyz/docs/ 308
    }
    handle /docs/* {
        # Strip /docs so zh-CN.html etc. resolve under root (was missing:
        # localized pages silently served the English index fallback).
        uri strip_prefix /docs
        root * /srv/vantyr-static/docs
        file_server
        try_files {path} /index.html
    }
    # cctest monitor status/action API for the Model Routing admin page.
    # /api/cctest/* (status GET + verify/promote POSTs) is served by the
    # monitor sidecar, NOT the gateway; the monitor auth-checks requests
    # against the gateway's /api/user/self (Bearer pass-through). Long
    # read timeout: promote runs a synchronous cctest verification check.
    handle /api/cctest/* {
        reverse_proxy cctest-monitor:8787 {
            transport http {
                read_timeout 300s
            }
        }
    }
    reverse_proxy gateway:3000 {
        transport http {
            read_timeout 600s
        }
    }
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options nosniff
        -Server
    }
}

# GM Pay (epusdt) crypto top-up gateway. Own site block: the cashier is a
# full hosted page with absolute URLs built from app_uri=https://pay.vantyr.xyz.
pay.vantyr.xyz {
    reverse_proxy gmpay:8000
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options nosniff
        -Server
    }
}

# BEpusdt (secondary crypto rail, USDT on Aptos/Plasma etc.). The owner
# dashboard names the channel after the network (BASE/Plasma/...); Caddy
# route missing since the deployment — restored here.
pay2.vantyr.xyz {
    reverse_proxy bepusdt:8080
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options nosniff
        -Server
    }
}
