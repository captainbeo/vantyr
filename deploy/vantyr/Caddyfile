vantyr.xyz {
    # Corresponding Source (AGPL) archive + notices served from ./static/.
    # The SPA's own /static/js/* assets are NOT intercepted: these handles
    # match only /static/source/* and /static/brand/*.
    handle /static/source/* {
        root * /srv/vantyr-static
        # /static/source/x -> /srv/vantyr-static/source/x
        uri strip_prefix /static
        file_server
    }
    handle /static/brand/* {
        root * /srv/vantyr-static
        # /static/brand/logo.png -> /srv/vantyr-static/brand/logo.png
        uri strip_prefix /static
        file_server
    }
    # Setup & pricing guide (static HTML in Control Room styling).
    # /docs -> /docs/ (canonical trailing slash); /docs/* serves
    # static/docs/ directly so relative font paths resolve.
    # NOTE: redir needs the absolute target URL here — the two-argument
    # form `redir /docs/ 308` parses as "redirect to URL '308' with code
    # 302", which broke the no-slash path (SPA fallback served instead).
    handle /docs {
        redir https://vantyr.xyz/docs/ 308
    }
    handle /docs/* {
        # Strip /docs so zh-CN.html etc. resolve under root (was missing:
        # localized pages silently served the English index fallback).
        uri strip_prefix /docs
        root * /srv/vantyr-static/docs
        file_server
        try_files {path} /index.html
    }
    # cctest monitor status/action API for the Model Routing admin page.
    # /api/cctest/* (status GET + verify/promote POSTs) is served by the
    # monitor sidecar, NOT the gateway; the monitor auth-checks requests
    # against the gateway's /api/user/self (Bearer pass-through). Long
    # read timeout: promote runs a synchronous cctest verification check.
    handle /api/cctest/* {
        reverse_proxy cctest-monitor:8787 {
            transport http {
                read_timeout 300s
            }
        }
    }
    reverse_proxy gateway:3000 {
        transport http {
            read_timeout 600s
        }
    }
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options nosniff
        -Server
    }
}

# GM Pay (epusdt) crypto top-up gateway. Own site block: the cashier is a
# full hosted page with absolute URLs built from app_uri=https://pay.vantyr.xyz.
pay.vantyr.xyz {
    reverse_proxy gmpay:8000
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options nosniff
        -Server
    }
}
