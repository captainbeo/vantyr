# Vantyr compose environment — copy to .env and fill in real values.
# .env is untracked; never commit real secrets.

# PostgreSQL
POSTGRES_USER=vantyr
POSTGRES_PASSWORD=change-me
POSTGRES_DB=vantyr

# Redis
REDIS_PASSWORD=change-me

# Timezone
TZ=UTC

# --- Gateway secrets (set before first production run) ---
# SESSION_SECRET=random-32-plus-bytes
# CRYPTO_SECRET=random-32-plus-bytes

# --- Stripe (R3, test mode first) ---
# Stripe keys are entered in the admin UI (System Settings), not env:
# StripeApiSecret = sk_test_... / StripeWebhookSecret = whsec_...
# Webhook endpoint: POST /api/stripe/webhook

# --- SMTP + Turnstile (R4) ---
# SMTP settings are admin-UI DB options as well.
# TURNSTILE_SITE_KEY= (admin UI if env is not supported)
# TURNSTILE_SECRET_KEY=

# --- sub2api (R2) ---
# SUB2API_SECRET_KEY=

# --- cctest model-authenticity monitor (observe-only until enabled) ---
# Gateway PAT with channel-operate + log-read scopes (role-10 user
# 'cctest-sidecar' created by the owner; token from the user's
# Access Tokens page).
# CCTEST_GATEWAY_TOKEN=
# cct-... API key from cctest.ai console (admin@oryntis.ai).
# CCTEST_KEY=
# Full check (token audit, ~$0.3/check) vs quick fingerprint mode
# (attributionOnly, 3 requests). Default quick.
# CCTEST_FULL_CHECK=false
# One entry per seller key: name-prefix|base_url|seller_monitoring_key
#   e.g. selora|https://api.selora.lol|sk-...
#        a6|https://api.a6api.com|sk-...
#        mia|https://miarouter.online|sk-...
# (the prefix expands to every gateway channel whose name starts with it).
# Use dedicated capped monitoring keys, not the channel keys.
# CCTEST_SELLER_CHANNELS=
# Discord webhook for quarantine alerts (optional).
# CCTEST_DISCORD_WEBHOOK=
# Observe-only -> true flips it to enforcement (after the C1 week).
# CCTEST_ENFORCE=false
# Status/action server port for the Model Routing admin page (Caddy
# proxies /api/cctest/* here; 8787 default needs no explicit setting).
# CCTEST_STATUS_PORT=8787
# A6 key-sync job (optional): with both set, every cycle pulls the owner's
# daily "<MODEL> | <merchant>" A6 keys into the pin pool as standby
# channels (A6 management dashboard token + user id).
# A6_MANAGE_TOKEN=
# A6_MANAGE_USER=
# Sick-pin rotation: an active pin with errors and no successes in this
# many minutes is quarantined + rotated (default 60).
# SICK_WINDOW_MINUTES=60
# A6 key-sync interval in minutes (default 5 — owner rule 2026-10-19: new
# keys join the pool as fast as possible; the 60-min cctest cycle is
# independent and unchanged).
# SYNC_INTERVAL_MINUTES=5
# Knobs: cycle / eligible-prefixes / usage gate / fail thresholds.
# CCTEST_CYCLE_MINUTES=10
# CCTEST_MODEL_PREFIXES=claude,gpt
# CCTEST_USAGE_WINDOW_HOURS=168
# CCTEST_FAIL_THRESHOLD_SELORA=1
# CCTEST_FAIL_THRESHOLD_A6=2
# CCTEST_FAIL_THRESHOLD_MIA=2
# CCTEST_FAIL_THRESHOLD_YINGZ=2
# CCTEST_PERMANENT_FAILS=3
