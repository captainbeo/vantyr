# Vantyr compose environment — copy to .env and fill in real values.
# .env is untracked; never commit real secrets.

# PostgreSQL
POSTGRES_USER=vantyr
POSTGRES_PASSWORD=change-me
POSTGRES_DB=vantyr

# Redis
REDIS_PASSWORD=change-me

# Timezone
TZ=UTC

# --- Gateway secrets (set before first production run) ---
# SESSION_SECRET=random-32-plus-bytes
# CRYPTO_SECRET=random-32-plus-bytes

# --- Stripe (R3, test mode first) ---
# Stripe keys are entered in the admin UI (System Settings), not env:
# StripeApiSecret = sk_test_... / StripeWebhookSecret = whsec_...
# Webhook endpoint: POST /api/stripe/webhook

# --- SMTP + Turnstile (R4) ---
# SMTP settings are admin-UI DB options as well.
# TURNSTILE_SITE_KEY= (admin UI if env is not supported)
# TURNSTILE_SECRET_KEY=

# --- sub2api (R2) ---
# SUB2API_SECRET_KEY=

# --- cctest model-authenticity monitor (observe-only until enabled) ---
# Gateway PAT with channel-operate + log-read scopes (role-10 user
# 'cctest-sidecar' created by the owner; token from the user's
# Access Tokens page).
# CCTEST_GATEWAY_TOKEN=
# cct-... API key from cctest.ai console (admin@oryntis.ai).
# CCTEST_KEY=
# One entry per channel: name|base_url|seller_monitoring_key
#   e.g. selora-reseller|https://api.selora.lol|sk-...
#        a6-marketplace|https://api.a6api.com|sk-...
# Use dedicated capped monitoring keys, not the channel keys.
# CCTEST_SELLER_CHANNELS=
# Discord webhook for quarantine alerts (optional).
# CCTEST_DISCORD_WEBHOOK=
# Observe-only -> true flips it to enforcement (after the C1 week).
# CCTEST_ENFORCE=false
# Knobs: cycle / eligible-prefixes / usage gate / fail thresholds.
# CCTEST_CYCLE_MINUTES=10
# CCTEST_MODEL_PREFIXES=claude,gpt
# CCTEST_USAGE_WINDOW_HOURS=168
# CCTEST_FAIL_THRESHOLD_SELORA=1
# CCTEST_FAIL_THRESHOLD_A6=2
# CCTEST_PERMANENT_FAILS=3
