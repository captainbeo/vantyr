#!/usr/bin/env bash
set -euo pipefail

mode=${1:-up}
if [[ "$mode" != "up" ]]; then
	printf 'usage: %s up\n' "$0" >&2
	exit 64
fi

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
proof_dir=$(mktemp -d /tmp/commercial-mvp-gateway-proof.XXXXXX)
env_file=$proof_dir/build.env
project_name="commercial-mvp-gateway-proof-$$"
network_name="${project_name}_backend"
network_subnet=${MVP_GATEWAY_NETWORK_SUBNET:-}
network_created=false
started=false

cleanup() {
	if [[ "$started" == true && "$project_name" == commercial-mvp-gateway-proof-* ]]; then
		docker compose -p "$project_name" --env-file "$env_file" -f "$script_dir/compose.yaml" down --volumes --remove-orphans >/dev/null 2>&1 || true
	fi
	if [[ "$network_created" == true && "$network_name" == commercial-mvp-gateway-proof-* ]]; then
		docker network rm "$network_name" >/dev/null 2>&1 || true
	fi
	if [[ "${MVP_GATEWAY_BUILD_CONTEXT:-}" == /tmp/commercial-mvp-gateway.* ]]; then
		rm -rf -- "$MVP_GATEWAY_BUILD_CONTEXT"
	fi
	if [[ "$proof_dir" == /tmp/commercial-mvp-gateway-proof.* ]]; then
		rm -rf -- "$proof_dir"
	fi
}
trap cleanup EXIT INT TERM

umask 077
sh "$script_dir/prepare-gateway-context.sh" "$env_file"
set -a
. "$env_file"
set +a

export MVP_POSTGRES_PASSWORD=$(openssl rand -hex 32)
export MVP_REDIS_PASSWORD=$(openssl rand -hex 32)
export MVP_SESSION_SECRET=$(openssl rand -hex 32)
export MVP_GATEWAY_KEY_PEPPER=$(openssl rand -hex 32)
export MVP_MOCK_PRIMARY_CONTROL_TOKEN=$(openssl rand -hex 32)
export MVP_MOCK_SECONDARY_CONTROL_TOKEN=$(openssl rand -hex 32)
export MVP_MOCK_PRIMARY_RELAY_CREDENTIAL=$(openssl rand -hex 32)
export MVP_MOCK_SECONDARY_RELAY_CREDENTIAL=$(openssl rand -hex 32)

compose=(docker compose -p "$project_name" --env-file "$env_file" -f "$script_dir/compose.yaml")
rendered=$proof_dir/rendered.yaml
"${compose[@]}" config > "$rendered"
printf 'gateway_config_bytes=%s\n' "$(wc -c < "$rendered")"
for secret in \
	"$MVP_POSTGRES_PASSWORD" \
	"$MVP_REDIS_PASSWORD" \
	"$MVP_SESSION_SECRET" \
	"$MVP_GATEWAY_KEY_PEPPER" \
	"$MVP_MOCK_PRIMARY_CONTROL_TOKEN" \
	"$MVP_MOCK_SECONDARY_CONTROL_TOKEN" \
	"$MVP_MOCK_PRIMARY_RELAY_CREDENTIAL" \
	"$MVP_MOCK_SECONDARY_RELAY_CREDENTIAL"; do
	if grep -Fq "$secret" "$rendered"; then
		echo 'rendered Compose configuration exposed a secret' >&2
		exit 1
	fi
done
printf 'gateway_config_secrets=passed\n'

network_create_args=(--driver bridge)
if [[ -n "$network_subnet" ]]; then
	network_create_args+=(--subnet "$network_subnet")
fi
docker network create "${network_create_args[@]}" \
	--label "com.docker.compose.project=$project_name" \
	--label 'com.docker.compose.network=backend' \
	"$network_name" >/dev/null
network_created=true
if [[ -n "$network_subnet" ]]; then
	printf 'gateway_network=prepared name=%s subnet=%s\n' "$network_name" "$network_subnet"
else
	printf 'gateway_network=prepared name=%s subnet=dynamic\n' "$network_name"
fi

started=true
"${compose[@]}" up --build --wait >/dev/null
running=$("${compose[@]}" ps --status running --services | sort)
expected=$(printf '%s\n' gateway mock-primary mock-secondary postgres redis | sort)
if [[ "$running" != "$expected" ]]; then
# Build the shared mock image before Compose resolves the secondary service.
# The secondary intentionally has no build stanza and reuses this image; on a
# clean host, `up --build` may otherwise try to pull it before the primary
# service has been built.
"${compose[@]}" build mock-primary >/dev/null
	echo 'not all MVP services are running' >&2
	exit 1
fi

seeded_disabled=$("${compose[@]}" exec -T postgres psql -U new_api -d new_api -At -v ON_ERROR_STOP=1 \
	-c "SELECT count(*) FROM channels WHERE id IN (910001, 910002) AND commercial_channel IS TRUE AND status = 2")
if [[ "$seeded_disabled" != "2" ]]; then
	echo 'first-start mock channels did not remain behind the restart activation fence' >&2
	exit 1
fi
printf '%s\n' \
	"INSERT INTO options (\"key\", value) VALUES ('ModelPrice', '{\"gpt-5.4\":0,\"gpt-5.5\":0,\"*-openai-compact\":0}') ON CONFLICT (\"key\") DO UPDATE SET value = EXCLUDED.value;" \
	"INSERT INTO options (\"key\", value) VALUES ('RetryTimes', '0') ON CONFLICT (\"key\") DO UPDATE SET value = EXCLUDED.value;" |
	"${compose[@]}" exec -T postgres psql -U new_api -d new_api -v ON_ERROR_STOP=1 >/dev/null
printf 'gateway_model_pricing_seed=passed\n'
"${compose[@]}" restart gateway >/dev/null
"${compose[@]}" up --wait gateway >/dev/null
# The account-pool proof runs while both authorized entries are active. The
# single-channel outage proof calls this fence after the pool assertion.
disable_secondary() {
  printf '%s\n' "UPDATE public.channels SET status = 2 WHERE id = 910002 AND commercial_channel IS TRUE;" "UPDATE public.abilities SET enabled = FALSE WHERE channel_id = 910002;" | "${compose[@]}" exec -T postgres psql -U new_api -d new_api -v ON_ERROR_STOP=1 >/dev/null
}
seed_counts=$("${compose[@]}" exec -T postgres psql -U new_api -d new_api -At -v ON_ERROR_STOP=1 -c "SELECT
  (SELECT count(*) FROM channels WHERE id IN (910001, 910002) AND commercial_channel IS TRUE AND status = 1 AND key IS NULL),

  (SELECT count(*) FROM abilities WHERE channel_id IN (910001, 910002) AND enabled IS TRUE AND model = 'gpt-5.4'),

  (SELECT count(*) FROM channel_reliability_policies WHERE channel_id IN (910001, 910002)),
  (SELECT count(*) FROM channel_cost_rates WHERE cost_profile_id IN (930001, 930002)),
  (SELECT count(*) FROM commercial_provider_accounts WHERE channel_id IN (910001, 910002))")
if [[ "$seed_counts" != "2|2|2|8|2" ]]; then
	echo "commercial mock channel seed verification failed: $seed_counts" >&2
	exit 1
fi
printf 'gateway_channel_seed=passed counts=%s\n' "$seed_counts"
compact_seed_counts=$("${compose[@]}" exec -T postgres psql -U new_api -d new_api -At -v ON_ERROR_STOP=1 -c "SELECT
  (SELECT count(*) FROM channels WHERE id IN (910001, 910002) AND models LIKE '%gpt-5.4-openai-compact%'),
  (SELECT count(*) FROM abilities WHERE channel_id IN (910001, 910002) AND enabled IS TRUE AND model = 'gpt-5.4-openai-compact')")
if [[ "$compact_seed_counts" != "2|2" ]]; then
	echo "commercial compact mock seed verification failed: $compact_seed_counts" >&2
	exit 1
fi
printf 'gateway_compact_seed=passed counts=%s\n' "$compact_seed_counts"

commercial_keys_env=$proof_dir/commercial-keys.env
python3 - "$commercial_keys_env" <<'PY'
import base64
import hashlib
import hmac
import os
import secrets
import sys

output = sys.argv[1]
pepper = os.environ["MVP_GATEWAY_KEY_PEPPER"]
rfc32 = "ABCDEFGHIJKLMNOPQRSTUVWXYZ234567"
crockford32 = "0123456789ABCDEFGHJKMNPQRSTVWXYZ"
translation = str.maketrans(rfc32, crockford32)

def encode(data):
    return base64.b32encode(data).decode("ascii").rstrip("=").translate(translation)

with open(output, "w", encoding="ascii") as env:
    for name in ("valid", "expired", "disabled", "exhausted", "wrong_group", "wrong_model"):
        public_id = encode(secrets.token_bytes(16))
        secret = encode(secrets.token_bytes(32))
        digest = hmac.new(pepper.encode("ascii"), f"pxv1.{public_id}.{secret}".encode("ascii"), hashlib.sha256).hexdigest()
        env.write(f"{name}_key=sk-pxv1.{public_id}.{secret}\n")
        env.write(f"{name}_public_id={public_id}\n")
        env.write(f"{name}_digest_hex={digest}\n")
PY
. "$commercial_keys_env"

seed_sql=$(cat <<SQL
BEGIN;
INSERT INTO public.users (id, username, password, display_name, role, status, email, "group", aff_code, quota, used_quota, request_count, auth_version)
VALUES (990001, 'private-mvp-http', '', 'private-mvp-http', 1, 1, 'private-mvp-http@example.invalid', 'default', 'mvp990001', 100000000, 0, 0, 1);
INSERT INTO public.subscription_plans (id, title, subtitle, price_amount, currency, duration_unit, duration_value, custom_seconds, enabled, sort_order, total_amount, quota_reset_period, quota_reset_custom_seconds)
VALUES (990001, 'Limited Monthly', 'private proof plan', 27, 'USD', 'month', 1, 0, true, 0, 45000, 'monthly', 0);
INSERT INTO public.commercial_plan_versions
  (id, plan_id, version, code, display_name, currency, price_microusd, billing_cycle, request_quota, token_quota, concurrency_limit, image_hour_limit, default_model_alias, default_reasoning_effort, enabled, effective_at)
VALUES (990001, 990001, 1, 'limited-monthly-v1', 'Limited Monthly', 'USD', 27000000, 'monthly', 45000, NULL, 6, NULL, 'gpt-5.4', 'xhigh', true, now() - interval '1 day');
INSERT INTO public.user_subscriptions
  (id, user_id, plan_id, amount_total, amount_used, start_time, end_time, status, source, last_reset_time, next_reset_time, upgrade_group, prev_user_group, downgrade_group, allow_wallet_overflow, plan_version_id, quota_reset_version)
VALUES (990001, 990001, 990001, 45000, 0, extract(epoch FROM now() - interval '1 hour')::bigint, extract(epoch FROM now() + interval '30 days')::bigint, 'active', 'proof', 0, 0, '', '', '', false, 990001, 1);
INSERT INTO public.commercial_billing_periods
  (id, user_subscription_id, plan_version_id, provider, provider_subscription_id, period_start, period_end, reset_version, status)
VALUES (990001, 990001, 990001, 'test', 'sub_mvp_990001', now() - interval '1 hour', now() + interval '30 days', 1, 'active');
UPDATE public.user_subscriptions
SET current_billing_period_id = 990001
WHERE id = 990001;
INSERT INTO public.commercial_plan_entitlements (id, plan_version_id, model_alias, reasoning_effort, image_allowed)
VALUES
  (990001, 990001, 'gpt-5.4', 'xhigh', false),
  (990002, 990001, 'gpt-5.5', 'xhigh', false);
INSERT INTO public.tokens (id, user_id, key, gateway_public_id, gateway_verifier_version, gateway_verifier_digest, commercial_key, status, name, created_time, accessed_time, expired_time, remain_quota, unlimited_quota, model_limits_enabled, model_limits, "group", cross_group_retry)
VALUES
  (990001, 990001, NULL, '$valid_public_id', 1, decode('$valid_digest_hex', 'hex'), true, 1, 'private-mvp-valid', extract(epoch FROM now())::bigint, extract(epoch FROM now())::bigint, -1, 100000000, true, true, 'gpt-5.4,gpt-5.4-openai-compact,gpt-5.5,gpt-5.5-openai-compact', 'default', false),
  (990002, 990001, NULL, '$expired_public_id', 1, decode('$expired_digest_hex', 'hex'), true, 1, 'private-mvp-expired', extract(epoch FROM now())::bigint, extract(epoch FROM now())::bigint, 1, 100000000, false, true, 'gpt-5.4,gpt-5.4-openai-compact,gpt-5.5,gpt-5.5-openai-compact', 'default', false),
  (990003, 990001, NULL, '$disabled_public_id', 1, decode('$disabled_digest_hex', 'hex'), true, 2, 'private-mvp-disabled', extract(epoch FROM now())::bigint, extract(epoch FROM now())::bigint, -1, 100000000, false, true, 'gpt-5.4,gpt-5.4-openai-compact,gpt-5.5,gpt-5.5-openai-compact', 'default', false),
  (990004, 990001, NULL, '$exhausted_public_id', 1, decode('$exhausted_digest_hex', 'hex'), true, 4, 'private-mvp-exhausted', extract(epoch FROM now())::bigint, extract(epoch FROM now())::bigint, -1, 0, false, true, 'gpt-5.4,gpt-5.4-openai-compact,gpt-5.5,gpt-5.5-openai-compact', 'default', false),
  (990005, 990001, NULL, '$wrong_group_public_id', 1, decode('$wrong_group_digest_hex', 'hex'), true, 1, 'private-mvp-wrong-group', extract(epoch FROM now())::bigint, extract(epoch FROM now())::bigint, -1, 100000000, true, true, 'gpt-5.4,gpt-5.4-openai-compact,gpt-5.5,gpt-5.5-openai-compact', 'not-allowed', false),
  (990006, 990001, NULL, '$wrong_model_public_id', 1, decode('$wrong_model_digest_hex', 'hex'), true, 1, 'private-mvp-wrong-model', extract(epoch FROM now())::bigint, extract(epoch FROM now())::bigint, -1, 100000000, true, true, 'gpt-5.5', 'default', false);
INSERT INTO public.commercial_access_projections
  (id, customer_id, token_id, user_subscription_id, plan_version_id, billing_period_id, reset_version, provider_customer_id, provider_subscription_id, status, version)
VALUES
  (990001, 990001, 990001, 990001, 990001, 990001, 1, 'cus_mvp_990001', 'sub_mvp_990001', 'active', 1),
  (990002, 990001, 990006, 990001, 990001, 990001, 1, 'cus_mvp_990001', 'sub_mvp_990001', 'active', 1);
COMMIT;
SQL
)
printf '%s\n' "$seed_sql" | "${compose[@]}" exec -T postgres psql -U new_api -d new_api -v ON_ERROR_STOP=1 >/dev/null
unset seed_sql

# Fixture setup mirrors the explicit epoch activation sequence: initialize
# Redis while the PostgreSQL row is still closed, then activate that exact
# epoch in PostgreSQL. Production activation is covered by its service tests.
epoch_closed_version=$("${compose[@]}" exec -T postgres psql -U new_api -d new_api -At -v ON_ERROR_STOP=1 -c "SELECT version FROM enforcement_epochs WHERE singleton_id = 1 AND epoch = 1 AND state = 'closed' AND activated_at IS NULL")
if [[ ! "$epoch_closed_version" =~ ^[1-9][0-9]*$ ]]; then
	echo "commercial enforcement epoch was not closed before activation: version=$epoch_closed_version" >&2
	exit 1
fi
"${compose[@]}" exec -T redis /bin/sh -c '
	set -eu
	export REDISCLI_AUTH=$(cat /run/secrets/redis_password)
	redis-cli --no-auth-warning SET commercial:enforcement:epoch:v1 1 >/dev/null
	unset REDISCLI_AUTH
'
epoch_activation=$("${compose[@]}" exec -T postgres psql -U new_api -d new_api -At -v ON_ERROR_STOP=1 -c "
WITH activated AS (
  UPDATE public.enforcement_epochs
  SET state = 'active', activated_at = now(), version = version + 1, updated_at = now()
  WHERE singleton_id = 1 AND epoch = 1 AND state = 'closed' AND activated_at IS NULL AND version = $epoch_closed_version
  RETURNING singleton_id
)
SELECT count(*) FROM activated;
")
if [[ "$epoch_activation" != "1" ]]; then
	echo "commercial enforcement epoch activation CAS did not update exactly one row: $epoch_activation" >&2
	exit 1
fi

commercial_access_seed_counts=$("${compose[@]}" exec -T postgres psql -U new_api -d new_api -At -v ON_ERROR_STOP=1 -c "SELECT
  (SELECT count(*) FROM commercial_plan_versions WHERE id = 990001 AND enabled IS TRUE),
  (SELECT count(*) FROM commercial_billing_periods WHERE id = 990001 AND status = 'active'),
  (SELECT count(*) FROM user_subscriptions WHERE id = 990001 AND current_billing_period_id = 990001 AND plan_version_id = 990001),
  (SELECT count(*) FROM commercial_plan_entitlements WHERE plan_version_id = 990001 AND image_allowed IS FALSE),
  (SELECT count(*) FROM commercial_access_projections WHERE token_id IN (990001, 990006) AND status = 'active')")
if [[ "$commercial_access_seed_counts" != "1|1|1|2|2" ]]; then
	echo "commercial access fixture seed verification failed: $commercial_access_seed_counts" >&2
	exit 1
fi
printf 'gateway_commercial_access_seed=passed counts=%s\n' "$commercial_access_seed_counts"
epoch_seed_counts=$("${compose[@]}" exec -T postgres psql -U new_api -d new_api -At -v ON_ERROR_STOP=1 -c "SELECT
  (SELECT count(*) FROM enforcement_epochs WHERE singleton_id = 1 AND epoch = 1 AND state = 'active'),
  (SELECT count(*) FROM enforcement_epochs WHERE singleton_id = 1 AND activated_at IS NOT NULL)")
redis_epoch=$("${compose[@]}" exec -T redis /bin/sh -c '
	set -eu
	export REDISCLI_AUTH=$(cat /run/secrets/redis_password)
	redis-cli --no-auth-warning GET commercial:enforcement:epoch:v1
	unset REDISCLI_AUTH
')
if [[ "$epoch_seed_counts" != "1|1" || "$redis_epoch" != "1" ]]; then
	echo "commercial enforcement epoch activation failed: postgres=$epoch_seed_counts redis=$redis_epoch" >&2
	exit 1
fi
printf 'gateway_epoch_projection=passed postgres=%s redis=%s\n' "$epoch_seed_counts" "$redis_epoch"

make_auth_file() {
	local key=$1
	local path=$2
	printf 'header = "Authorization: Bearer %s"\n' "$key" > "$path"
}

valid_auth=$proof_dir/auth-valid
expired_auth=$proof_dir/auth-expired
disabled_auth=$proof_dir/auth-disabled
exhausted_auth=$proof_dir/auth-exhausted
wrong_group_auth=$proof_dir/auth-wrong-group
wrong_model_auth=$proof_dir/auth-wrong-model
make_auth_file "$valid_key" "$valid_auth"
make_auth_file "$expired_key" "$expired_auth"
make_auth_file "$disabled_key" "$disabled_auth"
make_auth_file "$exhausted_key" "$exhausted_auth"
make_auth_file "$wrong_group_key" "$wrong_group_auth"
make_auth_file "$wrong_model_key" "$wrong_model_auth"

gateway_url=http://127.0.0.1:3000
request() {
	local auth_file=$1
	local method=$2
	local path=$3
	local body=$4
	local expected=$5
	local output=$6
	local accept=${7:-application/json}
	local status
	if [[ "$method" == GET ]]; then
		status=$(curl --silent --show-error --config "$auth_file" --output "$output" --write-out '%{http_code}' "$gateway_url$path")
	else
		status=$(curl --silent --show-error --config "$auth_file" --header 'Content-Type: application/json' --header "Accept: $accept" --data-binary "$body" --output "$output" --write-out '%{http_code}' "$gateway_url$path")
	fi
	if [[ "$status" != "$expected" ]]; then
		if [[ "${MVP_DEBUG_GATEWAY_ERRORS:-}" == "1" && -s "$output" ]]; then
			python3 - "$output" <<'PY' >&2
import json, sys
try:
    body = json.load(open(sys.argv[1], encoding="utf-8"))
except Exception:
    print("gateway_error_body=non_json", file=sys.stderr)
else:
    error = body.get("error") if isinstance(body, dict) else None
    if isinstance(error, dict):
        print({key: error.get(key) for key in ("type", "code", "param", "message")}, file=sys.stderr)
    else:
        print({"top_level_keys": sorted(body) if isinstance(body, dict) else type(body).__name__}, file=sys.stderr)
PY
		fi
		echo "unexpected gateway status for $method $path: $status (expected $expected)" >&2
		exit 1
	fi
}

request_any_status() {
	local auth_file=$1
	local path=$2
	local body=$3
	local output=$4
	local status
	status=$(curl --silent --show-error --config "$auth_file" --header 'Content-Type: application/json' --header 'Accept: application/json' --data-binary "$body" --output "$output" --write-out '%{http_code}' "$gateway_url$path")
	case ",$5," in
		*,"$status",*) return 0 ;;
		*) echo "unexpected gateway status for POST $path: $status" >&2; exit 1 ;;
	esac
}

request_no_auth() {
	local path=$1
	local body=$2
	local expected=$3
	local output=$4
	local status
	status=$(curl --silent --show-error --header 'Content-Type: application/json' --header 'Accept: application/json' --data-binary "$body" --output "$output" --write-out '%{http_code}' "$gateway_url$path")
	if [[ "$status" != "$expected" ]]; then
		echo "unexpected unauthenticated gateway status for $path: $status (expected $expected)" >&2
		exit 1
	fi
}

pool_attempt_count() {
	local port=$1
	local token=$2
	local output=$proof_dir/pool-attempts-$port.json
	local auth=$proof_dir/pool-control-$port
	printf 'header = "Authorization: Bearer %s"\n' "$token" > "$auth"

	curl --silent --show-error --fail --config "$auth" --output "$output" "http://127.0.0.1:$port/control/attempts"
	python3 - "$output" <<'PY'
import json, sys
print(json.load(open(sys.argv[1], encoding="utf-8"))["total_attempts"])
PY
}

pool_primary_before=$(pool_attempt_count 18081 "$MVP_MOCK_PRIMARY_CONTROL_TOKEN")
pool_secondary_before=$(pool_attempt_count 18082 "$MVP_MOCK_SECONDARY_CONTROL_TOKEN")
"${compose[@]}" exec -T redis /bin/sh -c '
	set -eu
	export REDISCLI_AUTH=$(cat /run/secrets/redis_password)
	lease_key=commercial:account-pool:lease:v1:910001
	limit_key=commercial:account-pool:limit:v1:910001
	redis-cli --no-auth-warning DEL "$lease_key" "$limit_key" >/dev/null
	now_ms=$(($(date +%s) * 1000))
	max_expiry=$((now_ms + 600000))
	redis-cli --no-auth-warning SET "$limit_key" "1|6" >/dev/null
	i=1
	while [ "$i" -le 6 ]; do
		redis-cli --no-auth-warning HSET "$lease_key" "pool-proof-$i" "pool-proof-owner|1|$now_ms|$max_expiry|$max_expiry" >/dev/null
		i=$((i + 1))
	done
	unset REDISCLI_AUTH
'
pool_response_json=$proof_dir/account-pool-response.json
request "$valid_auth" POST /v1/responses '{"model":"gpt-5.4","input":"pool-fixture","stream":false}' 200 "$pool_response_json"
python3 "$pool_response_json" <<'PY'
import json, sys
body = json.load(open(sys.argv[1], encoding="utf-8"))
if body.get("model") != "gpt-5.4" or body.get("status") != "completed":
    raise SystemExit(f"unexpected account-pool response: {body!r}")
raw = json.dumps(body)
for forbidden in ("primary-fixture-model", "secondary-fixture-model", "mock-primary", "mock-secondary", "provider_code", "account_label"):
    if forbidden in raw:
        raise SystemExit(f"account-pool response leaked provider metadata {forbidden!r}: {body!r}")
PY
pool_primary_after=$(pool_attempt_count 18081 "$MVP_MOCK_PRIMARY_CONTROL_TOKEN")
pool_secondary_after=$(pool_attempt_count 18082 "$MVP_MOCK_SECONDARY_CONTROL_TOKEN")
if [[ "$pool_primary_after" != "$pool_primary_before" || "$pool_secondary_after" != "$((pool_secondary_before + 1))" ]]; then
	echo "full primary pool entry did not route to secondary: primary=$pool_primary_before/$pool_primary_after secondary=$pool_secondary_before/$pool_secondary_after" >&2
	exit 1
fi
"${compose[@]}" exec -T redis /bin/sh -c '
	set -eu
	export REDISCLI_AUTH=$(cat /run/secrets/redis_password)
	redis-cli --no-auth-warning DEL commercial:account-pool:lease:v1:910001 commercial:account-pool:limit:v1:910001 >/dev/null
	unset REDISCLI_AUTH
'
printf 'gateway_account_pool_http=passed primary=%s secondary=%s\n' "$pool_primary_after" "$pool_secondary_after"

disable_secondary
models_json=$proof_dir/models.json
request "$valid_auth" GET /v1/models '' 200 "$models_json"
if ! python3 - "$models_json" <<'PY'
import json, sys
body = json.load(open(sys.argv[1], encoding="utf-8"))
ids = {item.get("id") for item in body.get("data", [])}
if "gpt-5.4" not in ids or any("fixture-model" in item for item in ids if isinstance(item, str)):
    raise SystemExit(f"unexpected public model aliases: {body!r}")
PY
then
	printf 'gateway_models_diagnostics_begin\n' >&2
	"${compose[@]}" exec -T postgres psql -U new_api -d new_api -At -F '|' -v ON_ERROR_STOP=1 -c "
SELECT 'user', id, username, \"group\", status FROM users WHERE id = 990001;
SELECT 'token', id, user_id, status, unlimited_quota, model_limits_enabled, model_limits, \"group\" FROM tokens WHERE id = 990001;
SELECT 'channel', id, type, status, commercial_channel, (key IS NULL), secret_ref, auth_type FROM channels WHERE id IN (910001, 910002) ORDER BY id;
SELECT 'ability', channel_id, \"group\", model, enabled FROM abilities WHERE channel_id IN (910001, 910002) ORDER BY channel_id, model;
SELECT 'migration', object_type, schema_name, object_name, phase, state, validated FROM commercial_channel_migration_objects WHERE migration_id = '2026-08-10-commercial-channel-foundation' ORDER BY object_type, schema_name, object_name;
" >&2
	printf 'gateway_models_diagnostics_end\n' >&2
	exit 1
fi
root_models_json=$proof_dir/root-models.json
request "$valid_auth" GET /models '' 200 "$root_models_json"
cmp "$models_json" "$root_models_json" >/dev/null || { echo 'root model alias differs from canonical response' >&2; exit 1; }
printf 'gateway_models=passed\n'

response_json=$proof_dir/response.json
request "$valid_auth" POST /v1/responses '{"model":"gpt-5.4","input":"fixture","stream":false}' 200 "$response_json"
python3 - "$response_json" <<'PY'
import json, sys
body = json.load(open(sys.argv[1], encoding="utf-8"))
if body.get("model") != "gpt-5.4" or body.get("status") != "completed":
    raise SystemExit(f"unexpected Responses JSON: {body!r}")
if any("fixture-model" in json.dumps(body) for _ in [0]):
    raise SystemExit("upstream model slug leaked in Responses JSON")
PY
root_response_json=$proof_dir/root-response.json
request "$valid_auth" POST /responses '{"model":"gpt-5.4","input":"fixture","stream":false}' 200 "$root_response_json"
printf 'gateway_responses_json=passed\n'

response_sse=$proof_dir/response.sse
request "$valid_auth" POST /v1/responses '{"model":"gpt-5.4","input":"fixture","stream":true}' 200 "$response_sse" text/event-stream
python3 - "$response_sse" <<'PY'
import json, sys
frames = []
for block in open(sys.argv[1], encoding="utf-8").read().strip().split("\n\n"):
    if not block:
        continue
    data_line = None
    event_name = None
    for line in block.splitlines():
        if line.startswith("data: ") and data_line is None:
            data_line = line[6:]
        elif line.startswith("event: ") and event_name is None:
            event_name = line[7:]
        else:
            raise SystemExit(f"unexpected SSE field: {line!r}")
    if data_line is None:
        raise SystemExit(f"SSE block has no data field: {block!r}")
    frame = json.loads(data_line)
    if event_name is not None and event_name != frame.get("type"):
        raise SystemExit(f"SSE event/type mismatch: {block!r}")
    frames.append(frame)
if [frame.get("type") for frame in frames] != ["response.created", "response.completed"]:
    raise SystemExit(f"unexpected SSE event order: {frames!r}")
if any((frame.get("response") or {}).get("model") != "gpt-5.4" for frame in frames):
    raise SystemExit(f"unexpected SSE model: {frames!r}")
if "fixture-model" in open(sys.argv[1], encoding="utf-8").read():
    raise SystemExit("upstream model slug leaked in SSE")
PY
printf 'gateway_responses_sse=passed\n'

compact_json=$proof_dir/compact.json
request "$valid_auth" POST /v1/responses/compact '{"model":"gpt-5.4","input":[]}' 200 "$compact_json"
python3 - "$compact_json" <<'PY'
import json, sys
body = json.load(open(sys.argv[1], encoding="utf-8"))
if body != {"output": []}:
    raise SystemExit(f"unexpected compact response: {body!r}")
PY
root_compact_json=$proof_dir/root-compact.json
request "$valid_auth" POST /responses/compact '{"model":"gpt-5.4","input":[]}' 200 "$root_compact_json"
printf 'gateway_responses_compact=passed\n'

attempts() {
	local port=$1
	local token=$2
	local output=$3
	local auth=$proof_dir/control-$port
	printf 'header = "Authorization: Bearer %s"\n' "$token" > "$auth"
	curl --silent --show-error --fail --config "$auth" --output "$output" "http://127.0.0.1:$port/control/attempts"
	python3 - "$output" <<'PY'
import json, sys
print(json.load(open(sys.argv[1], encoding="utf-8"))["total_attempts"])
PY
}

primary_before=$(attempts 18081 "$MVP_MOCK_PRIMARY_CONTROL_TOKEN" "$proof_dir/primary-before.json")
secondary_before=$(attempts 18082 "$MVP_MOCK_SECONDARY_CONTROL_TOKEN" "$proof_dir/secondary-before.json")
if (( primary_before <= 0 || secondary_before != 0 )); then
	echo "successful requests did not use only the primary mock channel: primary=$primary_before secondary=$secondary_before" >&2
	exit 1
fi
printf 'gateway_channel_attempts=passed primary=%s secondary=%s\n' "$primary_before" "$secondary_before"
request_no_auth /v1/responses '{"model":"gpt-5.4","input":"fixture"}' 401 "$proof_dir/reject-missing.json"
request "$expired_auth" POST /v1/responses '{"model":"gpt-5.4","input":"fixture"}' 401 "$proof_dir/reject-expired.json"
request "$disabled_auth" POST /v1/responses '{"model":"gpt-5.4","input":"fixture"}' 401 "$proof_dir/reject-disabled.json"
request "$exhausted_auth" POST /v1/responses '{"model":"gpt-5.4","input":"fixture"}' 401 "$proof_dir/reject-exhausted.json"
request "$wrong_group_auth" POST /v1/responses '{"model":"gpt-5.4","input":"fixture"}' 403 "$proof_dir/reject-group.json"
request_any_status "$wrong_model_auth" /v1/responses '{"model":"gpt-5.4","input":"fixture"}' "$proof_dir/reject-model.json" '400,403'
primary_after_reject=$(attempts 18081 "$MVP_MOCK_PRIMARY_CONTROL_TOKEN" "$proof_dir/primary-after-reject.json")
secondary_after_reject=$(attempts 18082 "$MVP_MOCK_SECONDARY_CONTROL_TOKEN" "$proof_dir/secondary-after-reject.json")
if [[ "$primary_before" != "$primary_after_reject" || "$secondary_before" != "$secondary_after_reject" ]]; then
	echo 'a rejected customer request reached a mock channel' >&2
	exit 1
fi
printf 'gateway_rejections=passed\n'

set_mode() {
	local port=$1
	local token=$2
	local mode=$3
	local auth=$proof_dir/control-mode-$port
	printf 'header = "Authorization: Bearer %s"\n' "$token" > "$auth"
	curl --silent --show-error --fail --config "$auth" --request PUT --header 'Content-Type: application/json' --data "{\"mode\":\"$mode\"}" "http://127.0.0.1:$port/control/mode" >/dev/null
}

set_mode 18081 "$MVP_MOCK_PRIMARY_CONTROL_TOKEN" unavailable
outage_json=$proof_dir/single-channel-outage.json
outage_status=$(curl --silent --show-error --config "$valid_auth" --header 'Content-Type: application/json' --header 'Accept: application/json' --data-binary '{"model":"gpt-5.4","input":"fixture","stream":false}' --output "$outage_json" --write-out '%{http_code}' "$gateway_url/v1/responses")
set_mode 18081 "$MVP_MOCK_PRIMARY_CONTROL_TOKEN" normal
if [[ "$outage_status" != "503" ]]; then
	echo "unexpected single-channel outage status: $outage_status (expected 503)" >&2
	exit 1
fi
python3 - "$outage_json" <<'PY'
import json, sys
body = json.load(open(sys.argv[1], encoding="utf-8"))
error = body.get("error")
if not isinstance(error, dict):
    raise SystemExit(f"single-channel outage did not return an error object: {body!r}")
if error.get("type") != "upstream_error" or error.get("code") != "bad_response_status_code":
    raise SystemExit(f"single-channel outage error was not classified safely: {body!r}")
if "upstream unavailable" not in str(error.get("message", "")):
    raise SystemExit(f"single-channel outage message was not sanitized: {body!r}")
raw = json.dumps(body)
for forbidden in ("mock request failed", "primary-fixture-model", "secondary-fixture-model", "http://", "https://", "X-Mock-Station-ID"):
    if forbidden in raw:
        raise SystemExit(f"single-channel outage leaked upstream detail {forbidden!r}: {body!r}")
PY
primary_after_outage=$(attempts 18081 "$MVP_MOCK_PRIMARY_CONTROL_TOKEN" "$proof_dir/primary-outage.json")
secondary_after_outage=$(attempts 18082 "$MVP_MOCK_SECONDARY_CONTROL_TOKEN" "$proof_dir/secondary-outage.json")
if (( primary_after_outage != primary_after_reject + 1 )); then
	echo "single-channel outage did not attempt the primary exactly once: before=$primary_after_reject after=$primary_after_outage" >&2
	exit 1
fi
if [[ "$secondary_after_outage" != "$secondary_after_reject" ]]; then
	echo "single-channel outage unexpectedly attempted the dormant secondary: before=$secondary_after_reject after=$secondary_after_outage" >&2
	exit 1
fi
printf 'gateway_single_channel_outage=passed primary_attempts=%s secondary_attempts=%s\n' "$primary_after_outage" "$secondary_after_outage"

printf 'gateway_http_proof=passed source_revision=%s\n' "$MVP_SOURCE_REVISION"
