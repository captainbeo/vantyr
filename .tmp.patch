diff --git a/service/billing_session.go b/service/billing_session.go
--- a/service/billing_session.go
+++ b/service/billing_session.go
@@ -48,12 +48,20 @@ func (s *BillingSession) Settle(actualQuota int) error {
 		return nil
 	}
 	if s.isCommercial() {
+		delta := actualQuota - s.preConsumedQuota
+		if wallet, ok := s.funding.(*CommercialWalletFunding); ok {
+			// Wallet PAYG prepares bounded actual usage; persistence occurs only at the fence.
+			if err := wallet.Settle(delta); err != nil {
+				return err
+			}
+		}
 		if !s.commitFenced {
 			return ErrCommercialBillingCommitRequired
 		}
-		// Commercial Responses are charged as exactly one request unit at the
-		// write fence. Never apply token-based or legacy subscription deltas.
+		// Subscription requests are charged as one request unit at the fence.
+		// Wallet-PAYG settlement has already persisted its actual amount there.
 		s.settled = true
 		s.fundingSettled = true
 		return nil
@@ -165,4 +173,5 @@ func (s *BillingSession) isCommercial() bool {
 		return false
 	}
-	_, ok := s.funding.(*CommercialSubscriptionFunding)
-	return ok
+	_, subscription := s.funding.(*CommercialSubscriptionFunding)
+	_, wallet := s.funding.(*CommercialWalletFunding)
+	return subscription || wallet
 }